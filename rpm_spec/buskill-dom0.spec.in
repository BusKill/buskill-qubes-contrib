%global debug_package %{nil}
Name: buskill-dom0
Version: @VERSION@
Release: @REL@%{?dist}

Summary: BusKill laptop kill cord for QubesOS (dom0 package)
License: GPLv3+
URL: https://www.buskill.in/

Source0: %{name}-%{version}.tar.gz

BuildRequires: make

Requires: qubes-core-dom0

%description
BusKill is a laptop kill cord. When the USB cable's magnetic breakaway is
severed, it triggers your computer to lock, shutdown, or shred its LUKS
encryption keys -- keeping your encrypted data safe from thieves.

This package installs the QubesOS qrexec service scripts and policies in dom0
that enable BusKill to execute triggers (lock screen, shutdown, reboot,
self-destruct) when a USB device is removed from sys-usb.

After installation, run the following command to configure sys-usb:
    sudo /usr/lib/qubes-buskill/buskill-postinstall.sh configure

To uninstall:
    sudo /usr/lib/qubes-buskill/buskill-postinstall.sh remove

%prep
%setup -q

%install
make install-dom0 DESTDIR=$RPM_BUILD_ROOT

%post
if [ $1 -eq 1 ]; then
    /usr/lib/qubes-buskill/buskill-postinstall.sh configure 2>/dev/null || true
fi

%preun
if [ $1 -eq 0 ]; then
    /usr/lib/qubes-buskill/buskill-postinstall.sh remove 2>/dev/null || true
fi

%files
%attr(0755, root, root) /etc/qubes-rpc/buskill.lock
%attr(0755, root, root) /etc/qubes-rpc/buskill.softShutdown
%attr(0755, root, root) /etc/qubes-rpc/buskill.hardReboot
%attr(0755, root, root) /etc/qubes-rpc/buskill.selfDestruct
%attr(0644, root, root) /etc/qubes-rpc/policy/buskill.lock
%attr(0644, root, root) /etc/qubes-rpc/policy/buskill.softShutdown
%attr(0644, root, root) /etc/qubes-rpc/policy/buskill.hardReboot
%attr(0644, root, root) /etc/qubes-rpc/policy/buskill.selfDestruct
%attr(0755, root, root) /usr/lib/qubes-buskill/buskill-postinstall.sh
%attr(0644, root, root) /usr/lib/qubes-buskill/vm/buskill.rules
%attr(0644, root, root) /usr/lib/qubes-buskill/vm/buskill.lock.rules
%attr(0755, root, root) /usr/lib/qubes-buskill/vm/buskill-disarm.sh

%changelog
@CHANGELOG@
