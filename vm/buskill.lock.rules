################################################################################
# File:    sys-usb:/etc/udev/rules.d/buskill.lock.rules
# Purpose: Just lock the screen (used by disarm script). For more info,
#          see: https://buskill.in/qubes-os/
# Authors: Michael Altfield <michael@buskill.in>
# Created: 2023-05-10
# License: GNU GPLv3
################################################################################
ACTION=="remove", SUBSYSTEM=="usb", RUN+="/usr/bin/qrexec-client-vm dom0 buskill.lock"
